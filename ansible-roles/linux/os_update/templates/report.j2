<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Linux OS Update Report - {{ os_update_result.host }}</title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 30px;
            color: #2c3e50;
        }

        .container {
            max-width: 1400px;
            margin: auto;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .subtitle {
            text-align: center;
            color: #7f8c8d;
            margin-bottom: 30px;
        }

        .status-banner {
            padding: 18px;
            border-radius: 8px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .status-success {
            background-color: #d5f5e3;
            color: #1e8449;
            border: 1px solid #82e0aa;
        }

        .status-failed {
            background-color: #fadbd8;
            color: #922b21;
            border: 1px solid #f1948a;
        }

        .section {
            margin-top: 25px;
            margin-bottom: 25px;
        }

        .section-title {
            background-color: #34495e;
            color: white;
            padding: 12px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 5px 5px 0 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        }

        th,
        td {
            padding: 11px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background-color: #ecf0f1;
            color: #2c3e50;
            width: 25%;
        }

        tr:nth-child(even) td {
            background-color: #fafafa;
        }

        .ok {
            color: #1e8449;
            font-weight: bold;
        }

        .fail {
            color: #c0392b;
            font-weight: bold;
        }

        .warning {
            color: #d68910;
            font-weight: bold;
        }

        .kernel-new {
            background-color: #d5f5e3;
            color: #1e8449;
            font-weight: bold;
        }

        .kernel-old {
            background-color: #f8f9f9;
        }

        .footer {
            margin-top: 30px;
            padding: 15px;
            text-align: center;
            color: #888;
            font-size: 13px;
        }

        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: bold;
        }

        .badge-success {
            background-color: #d5f5e3;
            color: #1e8449;
        }

        .badge-failed {
            background-color: #fadbd8;
            color: #922b21;
        }

        .badge-warning {
            background-color: #fcf3cf;
            color: #9a7d0a;
        }

        .two-column {
            display: table;
            width: 100%;
            border-spacing: 15px 0;
            margin-left: -15px;
            width: calc(100% + 30px);
        }

        .column {
            display: table-cell;
            width: 50%;
            vertical-align: top;
        }

        @media screen and (max-width: 800px) {
            body {
                padding: 10px;
            }

            .two-column {
                display: block;
                width: 100%;
                margin-left: 0;
            }

            .column {
                display: block;
                width: 100%;
                margin-bottom: 20px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <h1>🚀 Linux OS Update Report</h1>

    <div class="subtitle">
        Generated by Ansible
    </div>


    <!-- ====================================================== -->
    <!-- FINAL STATUS -->
    <!-- ====================================================== -->

    <div class="status-banner
        {% if os_update_result.status == 'SUCCESS' %}
            status-success
        {% else %}
            status-failed
        {% endif %}
    ">
        {% if os_update_result.status == 'SUCCESS' %}
            ✅ PATCHING SUCCESSFUL
        {% else %}
            ❌ PATCHING FAILED
        {% endif %}
    </div>


    <!-- ====================================================== -->
    <!-- HOST / OS INFORMATION -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            🖥 Host Information
        </div>

        <table>

            <tr>
                <th>Host</th>
                <td>{{ os_update_result.host }}</td>
            </tr>

            <tr>
                <th>FQDN</th>
                <td>{{ os_update_result.fqdn }}</td>
            </tr>

            <tr>
                <th>Operating System</th>
                <td>{{ os_update_result.os }}</td>
            </tr>

            <tr>
                <th>OS Version</th>
                <td>{{ os_update_result.os_version }}</td>
            </tr>

            <tr>
                <th>OS Family</th>
                <td>{{ os_update_result.os_family }}</td>
            </tr>

            <tr>
                <th>Architecture</th>
                <td>{{ os_update_result.architecture }}</td>
            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- KERNEL INFORMATION -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            🐧 Kernel Information
        </div>

        <table>

            <tr>
                <th>Old Running Kernel</th>

                <td class="kernel-old">
                    {{ os_update_result.old_kernel }}
                </td>
            </tr>

            <tr>
                <th>Installed Kernel</th>

                <td class="
                    {% if os_update_result.kernel_status == 'UPDATED' %}
                        kernel-new
                    {% endif %}
                ">
                    {{ os_update_result.new_kernel }}
                </td>
            </tr>

            <tr>
                <th>Currently Running Kernel</th>

                <td class="
                    {% if os_update_result.running_kernel == os_update_result.new_kernel %}
                        kernel-new
                    {% endif %}
                ">
                    {{ os_update_result.running_kernel }}
                </td>
            </tr>

            <tr>
                <th>Kernel Status</th>

                <td>
                    {% if os_update_result.kernel_status == 'UPDATED' %}
                        <span class="badge badge-success">
                            UPDATED
                        </span>
                    {% else %}
                        <span class="badge badge-warning">
                            UNCHANGED
                        </span>
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>New Kernel Detected</th>

                <td>
                    {% if os_update_result.new_kernel_detected | bool %}
                        <span class="badge badge-success">
                            YES
                        </span>
                    {% else %}
                        <span class="badge badge-warning">
                            NO
                        </span>
                    {% endif %}
                </td>
            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- OPERATIONS -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            🔧 Update Operations
        </div>

        <table>

            <tr>
                <th>Cleanup</th>

                <td class="
                    {% if os_update_result.cleanup_status in ['SUCCESS', 'SKIPPED'] %}
                        ok
                    {% else %}
                        fail
                    {% endif %}
                ">
                    {{ os_update_result.cleanup_status }}
                </td>
            </tr>

            <tr>
                <th>Patch</th>

                <td class="
                    {% if os_update_result.patch_status in ['SUCCESS', 'SKIPPED'] %}
                        ok
                    {% else %}
                        fail
                    {% endif %}
                ">
                    {{ os_update_result.patch_status }}
                </td>
            </tr>

            <tr>
                <th>Kernel Cleanup</th>

                <td class="
                    {% if os_update_result.kernel_cleanup_status in ['SUCCESS', 'SKIPPED'] %}
                        ok
                    {% else %}
                        fail
                    {% endif %}
                ">
                    {{ os_update_result.kernel_cleanup_status }}
                </td>
            </tr>

            <tr>
                <th>Reboot Required</th>

                <td>
                    {% if os_update_result.reboot_required | bool %}
                        <span class="badge badge-warning">
                            YES
                        </span>
                    {% else %}
                        <span class="badge badge-success">
                            NO
                        </span>
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Reboot Status</th>

                <td>
                    {% if os_update_result.reboot_status == 'REBOOTED' %}
                        <span class="badge badge-success">
                            REBOOTED
                        </span>

                    {% elif os_update_result.reboot_status == 'NOT_REQUIRED' %}
                        <span class="badge badge-success">
                            NOT REQUIRED
                        </span>

                    {% elif os_update_result.reboot_status == 'DISABLED' %}
                        <span class="badge badge-warning">
                            DISABLED
                        </span>

                    {% else %}
                        <span class="badge badge-failed">
                            {{ os_update_result.reboot_status }}
                        </span>
                    {% endif %}
                </td>
            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- POST CHECK -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            🔍 Post-Update Verification
        </div>

        <table>

            <tr>
                <th>Post Check</th>

                <td class="
                    {% if os_update_result.postcheck_status == 'SUCCESS' %}
                        ok
                    {% else %}
                        fail
                    {% endif %}
                ">
                    {% if os_update_result.postcheck_status == 'SUCCESS' %}
                        ✅ SUCCESS
                    {% else %}
                        ❌ FAILED
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Running Kernel</th>

                <td>
                    {{ os_update_result.running_kernel }}
                </td>
            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- TIMING -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            ⏱ Execution Information
        </div>

        <table>

            <tr>
                <th>Start Time</th>

                <td>
                    {{ os_update_result.start_time }}
                </td>
            </tr>

            <tr>
                <th>End Time</th>

                <td>
                    {{ os_update_result.end_time }}
                </td>
            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- FINAL STATUS -->
    <!-- ====================================================== -->

    <div class="section">

        <div class="section-title">
            📊 Final Result
        </div>

        <table>

            <tr>
                <th>Host</th>
                <td>{{ os_update_result.host }}</td>
            </tr>

            <tr>
                <th>Final Status</th>

                <td>
                    {% if os_update_result.status == 'SUCCESS' %}

                        <span class="badge badge-success">
                            ✅ SUCCESS
                        </span>

                    {% else %}

                        <span class="badge badge-failed">
                            ❌ FAILED
                        </span>

                    {% endif %}
                </td>

            </tr>

        </table>

    </div>


    <!-- ====================================================== -->
    <!-- FOOTER -->
    <!-- ====================================================== -->

    <div class="footer">

        Linux OS Update Automation<br>

        Host:
        {{ os_update_result.host }}

        <br>

        Report generated by Ansible

    </div>

</div>

</body>
</html>
