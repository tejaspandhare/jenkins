<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Linux Patch Report</title>

<style>
body{
    margin:0;
    background:#f4f6f9;
    font-family:Segoe UI,Arial,sans-serif;
    color:#333;
}

.wrapper{
    width:95%;
    max-width:1200px;
    margin:30px auto;
}

.header{
    background:linear-gradient(135deg,#1565C0,#42A5F5);
    color:#fff;
    padding:25px;
    border-radius:10px;
}

.header h1{
    margin:0;
}

.summary{
    display:flex;
    gap:20px;
    margin:25px 0;
    flex-wrap:wrap;
}

.card{
    flex:1;
    min-width:180px;
    background:white;
    padding:20px;
    border-radius:8px;
    text-align:center;
    box-shadow:0 2px 8px rgba(0,0,0,.1);
}

.card h2{
    margin:0;
    font-size:34px;
}

.total{
    border-top:5px solid #1565C0;
}

.success{
    border-top:5px solid #2E7D32;
}

.failed{
    border-top:5px solid #C62828;
}

.reboot{
    border-top:5px solid #EF6C00;
}

table{
    width:100%;
    border-collapse:collapse;
    background:white;
    box-shadow:0 2px 8px rgba(0,0,0,.1);
}

th{
    background:#1565C0;
    color:white;
    padding:14px;
}

td{
    padding:12px;
    border-bottom:1px solid #eee;
}

tr:nth-child(even){
    background:#fafafa;
}

tr:hover{
    background:#f1f8ff;
}

.badge{
    color:white;
    padding:5px 12px;
    border-radius:15px;
    font-size:13px;
    font-weight:bold;
}

.successBadge{
    background:#2E7D32;
}

.failedBadge{
    background:#C62828;
}

.warningBadge{
    background:#EF6C00;
}

.yes{
    color:#d32f2f;
    font-weight:bold;
}

.no{
    color:#2e7d32;
    font-weight:bold;
}

.footer{
    text-align:center;
    color:#777;
    margin-top:25px;
    font-size:13px;
}
</style>

</head>

<body>

{% set total = patch_results_summary | length %}
{% set success = patch_results_summary | selectattr('status','equalto','SUCCESS') | list | length %}
{% set failed = patch_results_summary | rejectattr('status','equalto','SUCCESS') | list | length %}
{% set reboot = patch_results_summary | selectattr('reboot','equalto','Yes') | list | length %}

<div class="wrapper">

<div class="header">
<h1>🚀 Linux Patch Report</h1>
<p><strong>Generated by:</strong> Jenkins + Ansible</p>
<p><strong>Date:</strong> {{ lookup('pipe','date') }}</p>
</div>

<div class="summary">

<div class="card total">
<h2>{{ total }}</h2>
<p>Total Hosts</p>
</div>

<div class="card success">
<h2>{{ success }}</h2>
<p>Successful</p>
</div>

<div class="card failed">
<h2>{{ failed }}</h2>
<p>Failed</p>
</div>

<div class="card reboot">
<h2>{{ reboot }}</h2>
<p>Reboot Required</p>
</div>

</div>

<table>

<tr>
<th>Host</th>
<th>OS</th>
<th>Old Kernel</th>
<th>New Kernel</th>
<th>Packages Updated</th>
<th>Reboot</th>
<th>Status</th>
</tr>

{% for host in patch_results_summary %}

<tr>

<td>{{ host.host }}</td>

<td>{{ host.os }}</td>

<td>{{ host.old_kernel }}</td>

<td>{{ host.new_kernel }}</td>

<td>
{% if host.updated == "Yes" %}
<span class="yes">Yes</span>
{% else %}
<span class="no">No</span>
{% endif %}
</td>

<td>
{% if host.reboot == "Yes" %}
<span class="yes">Yes</span>
{% else %}
<span class="no">No</span>
{% endif %}
</td>

<td>

{% if host.status == "SUCCESS" %}
<span class="badge successBadge">{{ host.status }}</span>
{% else %}
<span class="badge failedBadge">{{ host.status }}</span>
{% endif %}

</td>

</tr>

{% endfor %}

</table>

<div class="footer">

<hr>

<b>Execution Summary</b><br><br>

Total Hosts : {{ total }} |
Success : {{ success }} |
Failed : {{ failed }} |
Reboot Required : {{ reboot }}

<br><br>

Generated by Jenkins Pipeline &amp; Ansible Automation

</div>

</div>

</body>
</html>
