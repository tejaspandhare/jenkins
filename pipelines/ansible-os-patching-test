pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            description: 'Enter servers (semicolon separated): server1;server2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Packages to exclude (semicolon separated): kernel*;docker*'
        )
    }

    environment {
        /*
         * Locale
         */
        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'

        /*
         * Ansible
         */
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'

        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'

        ANSIBLE_HOST_KEY_CHECKING = 'false'

        /*
         * SSH control sockets must stay on local Jenkins filesystem.
         */
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {

                    if (!params.SERVER_NAME?.trim()) {
                        error("SERVER_NAME cannot be empty")
                    }

                    echo "============================================"
                    echo "SERVER_NAME : ${params.SERVER_NAME}"
                    echo "EXCLUDE_PKGS: ${params.EXCLUDE_PKGS ?: '(none)'}"
                    echo "============================================"
                }
            }
        }


        stage('Prepare Ansible Environment') {
            steps {
                sh '''
                    set -eu

                    echo "========== ANSIBLE ENVIRONMENT =========="

                    echo "LANG=${LANG}"
                    echo "LC_ALL=${LC_ALL}"

                    echo ""
                    echo "Locale:"
                    locale || true

                    echo ""
                    echo "Locale character map:"
                    locale charmap || true

                    echo ""
                    echo "Ansible version:"
                    ansible --version

                    echo ""
                    echo "Creating temporary directories..."

                    mkdir -p /tmp/ansible_tmp
                    mkdir -p /tmp/ansible_cp

                    chmod 700 /tmp/ansible_tmp
                    chmod 700 /tmp/ansible_cp

                    echo ""
                    echo "Temporary directories:"
                    ls -ld /tmp/ansible_tmp
                    ls -ld /tmp/ansible_cp
                '''
            }
        }


        stage('Verify Ansible Files') {
            steps {
                sh '''
                    set -eu

                    echo "========== VERIFY ANSIBLE FILES =========="

                    echo ""
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Inventory:"
                    ls -lh inventory/hosts

                    echo ""
                    echo "Playbook:"
                    ls -lh ansible-roles/linux/os_update.yml

                    echo ""
                    echo "Role:"
                    ls -ld ansible-roles/linux/os_update

                    echo ""
                    echo "Role main.yml:"
                    ls -lh ansible-roles/linux/os_update/tasks/main.yml

                    echo ""
                    echo "Number of lines in main.yml:"
                    wc -l ansible-roles/linux/os_update/tasks/main.yml
                '''
            }
        }


        stage('Ansible Syntax Check') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "========== ANSIBLE SYNTAX CHECK =========="

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_PKGS:-}" \
                            --syntax-check
                    '''
                }
            }
        }


        stage('Verify Ansible Role Tasks') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "========== ANSIBLE ROLE TASKS =========="

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_PKGS:-}" \
                            --list-tasks
                    '''
                }
            }
        }


        stage('Run Ansible Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "============================================"
                        echo "========== PATCH EXECUTION ================"
                        echo "============================================"

                        echo "Running patching on:"
                        echo "${SERVER_NAME}"

                        echo ""
                        echo "Excluded packages:"
                        echo "${EXCLUDE_PKGS:-"(none)"}"

                        echo ""
                        echo "Starting Ansible..."

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_PKGS:-}"
                    '''
                }
            }
        }


        stage('Check Report') {
            steps {
                sh '''
                    set +e

                    echo "============================================"
                    echo "========== REPORT FILE ====================="
                    echo "============================================"

                    echo ""
                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "Reports directory:"

                    if [ -d reports ]; then
                        ls -lah reports/
                    else
                        echo "reports directory does not exist"
                    fi

                    echo ""
                    echo "HTML reports:"

                    find reports \
                        -type f \
                        -name '*.html' \
                        -print 2>/dev/null || true

                    echo ""
                    echo "Searching workspace for HTML files:"

                    find . \
                        -type f \
                        -name '*.html' \
                        -print 2>/dev/null || true
                '''
            }
        }


        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'reports/*.html',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }
    }


    post {

        success {
            echo "============================================"
            echo "✅ Patching completed successfully"
            echo "============================================"
        }

        failure {
            echo "============================================"
            echo "❌ Patching failed"
            echo "============================================"
        }

        always {
            echo "========== CLEANING WORKSPACE =========="

            cleanWs()
        }
    }
}
