pipeline {

    agent any

    parameters {
        string(
            name: 'SERVER_NAME',
            description: 'Target server(s) from Ansible inventory'
        )

        string(
            name: 'EXCLUDE_PKGS',
            description: 'Packages to exclude from patching'
        )
    }

    environment {
        INVENTORY = 'inventory/hosts'
        PLAYBOOK  = 'ansible-roles/linux/os_update.yml'
        REPORT_DIR = 'reports'
    }

    options {
        timestamps()
        ansiColor('xterm')
        skipDefaultCheckout(false)
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    echo '============================================'
                    echo 'PATCH MANAGEMENT'
                    echo '============================================'
                    echo "Servers      : ${params.SERVER_NAME}"
                    echo "Exclude pkgs : ${params.EXCLUDE_PKGS}"
                    echo '============================================'

                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME is required')
                    }

                    if (!fileExists(env.INVENTORY)) {
                        error("Inventory not found: ${env.INVENTORY}")
                    }

                    if (!fileExists(env.PLAYBOOK)) {
                        error("Playbook not found: ${env.PLAYBOOK}")
                    }
                }
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    echo "Preparing Ansible environment..."

                    mkdir -p reports
                    mkdir -p /tmp/ansible_cp
                    chmod 700 /tmp/ansible_cp

                    echo "Workspace : $(pwd)"
                    echo "Inventory : ${INVENTORY}"
                    echo "Playbook  : ${PLAYBOOK}"
                    echo "Reports   : ${REPORT_DIR}"

                    test -f "${INVENTORY}"
                    test -f "${PLAYBOOK}"

                    echo "Environment ready."
                '''
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    script {

                        /*
                         * IMPORTANT:
                         *
                         * Do not put ${SERVER_NAME} or ${EXCLUDE_PKGS}
                         * inside the shell script.
                         *
                         * Jenkins/Groovy would try to interpolate them
                         * before the shell runs.
                         *
                         * Pass them through environment variables instead.
                         */

                        withEnv([
                            "PATCH_TARGET=${params.SERVER_NAME}",
                            "PATCH_EXCLUDE_PKGS=${params.EXCLUDE_PKGS}"
                        ]) {

                            def rc = sh(
                                script: '''
                                    set -eu

                                    echo ""
                                    echo "============================================"
                                    echo "ANSIBLE PATCH EXECUTION"
                                    echo "============================================"
                                    echo "Servers      : ${PATCH_TARGET}"

                                    if [ -n "${PATCH_EXCLUDE_PKGS}" ]; then
                                        echo "Exclude pkgs : ${PATCH_EXCLUDE_PKGS}"
                                    else
                                        echo "Exclude pkgs : NONE"
                                    fi

                                    echo "============================================"

                                    mkdir -p "${REPORT_DIR}"
                                    mkdir -p /tmp/ansible_cp
                                    chmod 700 /tmp/ansible_cp

                                    rm -f ansible-output.log

                                    export ANSIBLE_LOCAL_TEMP=/tmp/ansible_tmp
                                    export ANSIBLE_REMOTE_TEMP=/tmp/ansible_tmp
                                    export ANSIBLE_SSH_PIPELINING=true
                                    export ANSIBLE_HOST_KEY_CHECKING=false

                                    mkdir -p /tmp/ansible_tmp
                                    chmod 700 /tmp/ansible_tmp

                                    echo "Starting Ansible..."
                                    echo ""

                                    set +e

                                    ansible-playbook \
                                        -i "${INVENTORY}" \
                                        "${PLAYBOOK}" \
                                        --private-key="${ANSIBLE_KEY_FILE}" \
                                        -e "target_hosts=${PATCH_TARGET}" \
                                        -e "EXCLUDE_PKGS=${PATCH_EXCLUDE_PKGS}" \
                                        2>&1 | tee ansible-output.log

                                    ANSIBLE_RC=${PIPESTATUS[0]}

                                    set -e

                                    echo ""
                                    echo "============================================"
                                    echo "ANSIBLE EXIT CODE : ${ANSIBLE_RC}"
                                    echo "============================================"

                                    exit "${ANSIBLE_RC}"
                                ''',
                                returnStatus: true
                            )

                            env.ANSIBLE_EXIT_CODE = rc.toString()

                            echo "Ansible exit code : ${env.ANSIBLE_EXIT_CODE}"

                            /*
                             * Do not fail this stage immediately.
                             *
                             * This allows Check Report / Archive / Publish
                             * to execute even when Ansible fails.
                             */
                        }
                    }
                }
            }
        }

        stage('Check Report') {
            steps {
                sh '''
                    set -eu

                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ -d "${REPORT_DIR}" ]; then

                        echo "Reports directory:"
                        ls -lah "${REPORT_DIR}"

                        echo ""
                        echo "HTML reports:"

                        find "${REPORT_DIR}" \
                            -type f \
                            -name '*.html' \
                            -print

                    else
                        echo "Reports directory does not exist."
                    fi

                    echo ""
                    echo "Ansible log:"

                    if [ -f ansible-output.log ]; then
                        ls -lh ansible-output.log
                    else
                        echo "ansible-output.log does not exist."
                    fi

                    echo ""
                    echo "============================================"
                    echo "REPORT CHECK COMPLETE"
                    echo "============================================"
                '''
            }
        }

        stage('Archive Report') {
            steps {
                script {

                    echo "Checking for generated reports..."

                    def reportExists = sh(
                        script: '''
                            if [ -d reports ] && \
                               find reports -type f -name '*.html' -print -quit | grep -q .; then
                                exit 0
                            fi
                            exit 1
                        ''',
                        returnStatus: true
                    ) == 0

                    if (reportExists) {

                        echo "HTML report found. Archiving..."

                        archiveArtifacts(
                            artifacts: 'reports/**/*.html',
                            allowEmptyArchive: true,
                            fingerprint: true
                        )

                    } else {

                        echo "No HTML report generated. Nothing to archive."

                    }

                    if (fileExists('ansible-output.log')) {

                        archiveArtifacts(
                            artifacts: 'ansible-output.log',
                            allowEmptyArchive: true,
                            fingerprint: true
                        )

                    } else {

                        echo "No ansible-output.log found."

                    }
                }
            }
        }

        stage('Publish HTML Report') {
            steps {
                script {

                    def reportExists = sh(
                        script: '''
                            if [ -d reports ] && \
                               find reports -type f -name '*.html' -print -quit | grep -q .; then
                                exit 0
                            fi
                            exit 1
                        ''',
                        returnStatus: true
                    ) == 0

                    if (reportExists) {

                        echo "Publishing HTML report..."

                        publishHTML([
                            allowMissing: true,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'reports',
                            reportFiles: '*.html',
                            reportName: 'Linux Patch Report',
                            reportTitles: 'Linux OS Patching Report'
                        ])

                    } else {

                        echo "No HTML report generated. Skipping HTML publication."

                    }
                }
            }
        }

        stage('Finalize Result') {
            steps {
                script {

                    def rc = env.ANSIBLE_EXIT_CODE ?: '999'

                    echo "============================================"
                    echo "FINAL PATCH RESULT"
                    echo "============================================"
                    echo "Servers          : ${params.SERVER_NAME}"
                    echo "Ansible exit code: ${rc}"
                    echo "============================================"

                    if (rc != '0') {
                        error("Ansible patching failed with exit code ${rc}")
                    }

                    echo "Patching completed successfully."
                }
            }
        }
    }

    post {

        success {
            echo ""
            echo "============================================"
            echo "PATCHING JOB SUMMARY"
            echo "============================================"
            echo "Servers          : ${params.SERVER_NAME}"
            echo "Ansible exit code: ${env.ANSIBLE_EXIT_CODE}"
            echo "============================================"
            echo "✅ PATCHING COMPLETED SUCCESSFULLY"
            echo "============================================"
        }

        failure {
            echo ""
            echo "============================================"
            echo "PATCHING JOB SUMMARY"
            echo "============================================"
            echo "Servers          : ${params.SERVER_NAME}"
            echo "Ansible exit code: ${env.ANSIBLE_EXIT_CODE ?: 'UNKNOWN'}"
            echo "============================================"
            echo "❌ PATCHING FAILED"
            echo "============================================"
            echo "Check the Ansible output above for details."
            echo "============================================"
        }

        always {
            echo ""
            echo "============================================"
            echo "CLEANING WORKSPACE"
            echo "============================================"

            cleanWs()

            echo "Workspace cleaned."
            echo "============================================"
        }
    }
}
