pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        skipDefaultCheckout(false)
    }

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            description: 'Enter servers (semicolon separated): server1;server2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Packages to exclude (semicolon separated): kernel*;docker*'
        )
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'

        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'

        ANSIBLE_HOST_KEY_CHECKING = 'false'

        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'

        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error("SERVER_NAME cannot be empty")
                    }

                    echo "============================================"
                    echo "PATCH INPUT"
                    echo "============================================"
                    echo "Servers       : ${params.SERVER_NAME}"
                    echo "Exclude pkgs  : ${params.EXCLUDE_PKGS ?: 'NONE'}"
                    echo "============================================"
                }
            }
        }

        stage('Prepare Workspace') {
            steps {
                sh '''
                    set -eu

                    echo "============================================"
                    echo "PREPARING ANSIBLE ENVIRONMENT"
                    echo "============================================"

                    mkdir -p /tmp/ansible_tmp
                    mkdir -p /tmp/ansible_cp

                    chmod 700 /tmp/ansible_tmp
                    chmod 700 /tmp/ansible_cp

                    mkdir -p reports

                    echo "Workspace:"
                    pwd

                    echo
                    echo "Repository:"
                    ls -la

                    echo
                    echo "Ansible role:"
                    ls -la ansible-roles/linux/os_update

                    echo
                    echo "Reports directory:"
                    ls -ld reports
                '''
            }
        }

        stage('Ansible Syntax Check') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "============================================"
                        echo "ANSIBLE SYNTAX CHECK"
                        echo "============================================"

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --syntax-check

                        echo "============================================"
                        echo "SYNTAX CHECK PASSED"
                        echo "============================================"
                    '''
                }
            }
        }

        stage('Ansible Task List') {
            steps {
                sh '''
                    set -eu

                    echo "============================================"
                    echo "ANSIBLE TASK LIST"
                    echo "============================================"

                    ansible-playbook \
                        -i inventory/hosts \
                        ansible-roles/linux/os_update.yml \
                        -e "target_hosts=${SERVER_NAME}" \
                        --list-tasks
                '''
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION"
                        echo "============================================"
                        echo "Servers      : ${SERVER_NAME}"
                        echo "Exclude pkgs : ${EXCLUDE_PKGS:-NONE}"
                        echo "============================================"

                        # Always make sure report directory exists
                        mkdir -p reports

                        # Do not allow an empty EXCLUDE_PKGS value to break
                        # shell execution when nounset is enabled.
                        EXCLUDE_VALUE="${EXCLUDE_PKGS:-}"

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="${ANSIBLE_KEY_FILE}" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_VALUE}"

                        echo
                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION COMPLETED"
                        echo "============================================"
                    '''
                }
            }
        }

        stage('Check Report') {
            steps {
                sh '''
                    set +e

                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    echo
                    echo "Workspace:"
                    pwd

                    echo
                    echo "Reports directory:"
                    if [ -d reports ]; then
                        ls -lah reports
                    else
                        echo "WARNING: reports directory does not exist"
                    fi

                    echo
                    echo "HTML reports:"
                    find . -type f -name '*.html' -print

                    echo
                    echo "============================================"
                '''
            }
        }

        stage('Archive Report') {
            steps {
                script {
                    def reportFiles = sh(
                        script: "find reports -maxdepth 1 -type f -name '*.html' -print 2>/dev/null || true",
                        returnStdout: true
                    ).trim()

                    if (reportFiles) {
                        echo "HTML report(s) found:"
                        echo reportFiles

                        archiveArtifacts(
                            artifacts: 'reports/*.html',
                            fingerprint: true,
                            allowEmptyArchive: false
                        )
                    } else {
                        echo "WARNING: No HTML report was generated."
                        echo "Patching itself completed, but there is no report to archive."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "============================================"
            echo "✅ PATCHING COMPLETED SUCCESSFULLY"
            echo "============================================"
        }

        failure {
            echo "============================================"
            echo "❌ PATCHING FAILED"
            echo "============================================"
        }

        always {
            echo "============================================"
            echo "CLEANING WORKSPACE"
            echo "============================================"

            cleanWs()
        }
    }
}
