pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        skipDefaultCheckout(false)
    }

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            description: 'Enter servers (semicolon separated): server1;server2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Packages to exclude (semicolon separated): kernel*;docker*'
        )
    }

    environment {
        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'

        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'

        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'

        ANSIBLE_HOST_KEY_CHECKING = 'false'

        /*
         * Keep SSH multiplex/control sockets on local Jenkins storage.
         * This avoids NFS stale-file-handle problems.
         */
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME cannot be empty')
                    }

                    echo '============================================'
                    echo 'PATCH MANAGEMENT'
                    echo '============================================'
                    echo "Servers      : ${params.SERVER_NAME}"
                    echo "Exclude pkgs : ${params.EXCLUDE_PKGS?.trim() ?: 'NONE'}"
                    echo '============================================'
                }
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    echo "Preparing Ansible environment..."

                    mkdir -p /tmp/ansible_tmp
                    mkdir -p /tmp/ansible_cp
                    mkdir -p reports

                    chmod 700 /tmp/ansible_cp

                    echo "Workspace : $(pwd)"
                    echo "Inventory : inventory/hosts"
                    echo "Playbook  : ansible-roles/linux/os_update.yml"

                    test -f inventory/hosts
                    test -f ansible-roles/linux/os_update.yml

                    echo "Environment ready."
                '''
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo ""
                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION"
                        echo "============================================"
                        echo "Servers      : ${SERVER_NAME}"
                        echo "Exclude pkgs : ${EXCLUDE_PKGS:-NONE}"
                        echo "============================================"

                        mkdir -p reports

                        /*
                         * Do not use Groovy interpolation for the credential.
                         * Jenkins will mask the credential path/value appropriately.
                         */

                        if [ -n "${EXCLUDE_PKGS:-}" ]; then

                            ansible-playbook \
                                -i inventory/hosts \
                                ansible-roles/linux/os_update.yml \
                                --private-key="$ANSIBLE_KEY_FILE" \
                                -e "target_hosts=${SERVER_NAME}" \
                                -e "EXCLUDE_PKGS=${EXCLUDE_PKGS}"

                        else

                            ansible-playbook \
                                -i inventory/hosts \
                                ansible-roles/linux/os_update.yml \
                                --private-key="$ANSIBLE_KEY_FILE" \
                                -e "target_hosts=${SERVER_NAME}" \
                                -e "EXCLUDE_PKGS="

                        fi

                        echo ""
                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION COMPLETED"
                        echo "============================================"
                    '''
                }
            }
        }

        stage('Check Report') {
            steps {
                sh '''
                    set -eu

                    echo ""
                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ -d reports ]; then

                        echo "Reports directory:"
                        ls -lah reports

                        echo ""
                        echo "HTML reports:"

                        find reports \
                            -type f \
                            -name '*.html' \
                            -print

                        echo ""
                        echo "Report count:"

                        find reports \
                            -type f \
                            -name '*.html' \
                            | wc -l

                    else

                        echo "ERROR: reports directory does not exist."
                        exit 1

                    fi

                    echo ""
                    echo "============================================"
                '''
            }
        }

        stage('Archive Report') {
            steps {
                /*
                 * No findFiles() here.
                 *
                 * archiveArtifacts is built into Jenkins and does not
                 * require Pipeline Utility Steps.
                 */

                archiveArtifacts(
                    artifacts: 'reports/*.html',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {

        success {
            echo ""
            echo "============================================"
            echo "✅ PATCHING COMPLETED SUCCESSFULLY"
            echo "============================================"
            echo "HTML report has been archived."
        }

        failure {
            echo ""
            echo "============================================"
            echo "❌ PATCHING FAILED"
            echo "============================================"
            echo "Check the Ansible output above for details."
        }

        always {
            echo ""
            echo "============================================"
            echo "CLEANING WORKSPACE"
            echo "============================================"

            cleanWs()
        }
    }
}
