pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        skipDefaultCheckout(false)
        disableConcurrentBuilds()
    }

    parameters {

        string(
            name: 'PATCH_SERVERS',
            defaultValue: 'lb2',
            description: 'Ansible target hosts. Example: lb2 or lb1;lb2'
        )

        string(
            name: 'PATCH_EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Optional packages to exclude. Example: kernel*;openssl'
        )
    }

    environment {

        ANSIBLE_PLAYBOOK = 'ansible-roles/linux/os_update.yml'
        ANSIBLE_INVENTORY = 'inventory/hosts'

        ANSIBLE_REMOTE_TMP = '/tmp/ansible_tmp'
        ANSIBLE_LOCAL_TMP = '/tmp/ansible_cp'

        REPORT_DIR = 'reports'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {

                    echo '============================================'
                    echo 'PATCH MANAGEMENT'
                    echo '============================================'
                    echo "Servers      : ${params.PATCH_SERVERS}"

                    if (params.PATCH_EXCLUDE_PKGS?.trim()) {
                        echo "Exclude pkgs : ${params.PATCH_EXCLUDE_PKGS}"
                    } else {
                        echo 'Exclude pkgs : NONE'
                    }

                    echo '============================================'

                    if (!params.PATCH_SERVERS?.trim()) {
                        error('PATCH_SERVERS cannot be empty')
                    }
                }
            }
        }


        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    echo "Preparing Ansible environment..."

                    mkdir -p "${REPORT_DIR}"
                    mkdir -p "${ANSIBLE_LOCAL_TMP}"

                    chmod 700 "${ANSIBLE_LOCAL_TMP}"

                    echo "Workspace : $(pwd)"
                    echo "Inventory : ${ANSIBLE_INVENTORY}"
                    echo "Playbook  : ${ANSIBLE_PLAYBOOK}"
                    echo "Reports   : ${REPORT_DIR}"

                    test -f "${ANSIBLE_INVENTORY}"
                    test -f "${ANSIBLE_PLAYBOOK}"

                    echo "Environment ready."
                '''
            }
        }


        stage('Run Ansible Patching') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ansible-ssh-key',
                        keyFileVariable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {

                    sh '''
                        set -eu

                        echo ""
                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION"
                        echo "============================================"
                        echo "Servers      : ${PATCH_SERVERS}"

                        if [ -n "${PATCH_EXCLUDE_PKGS:-}" ]; then
                            echo "Exclude pkgs : ${PATCH_EXCLUDE_PKGS}"
                        else
                            echo "Exclude pkgs : NONE"
                        fi

                        echo "============================================"

                        mkdir -p "${REPORT_DIR}"

                        if [ -n "${PATCH_EXCLUDE_PKGS:-}" ]; then

                            echo "Starting Ansible patch..."

                            LANG=C.UTF-8 LC_ALL=C.UTF-8 \
                            ansible-playbook \
                                -i "${ANSIBLE_INVENTORY}" \
                                "${ANSIBLE_PLAYBOOK}" \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts=${PATCH_SERVERS}" \
                                -e "EXCLUDE_PKGS=${PATCH_EXCLUDE_PKGS}"

                        else

                            echo "Starting Ansible patch..."

                            LANG=C.UTF-8 LC_ALL=C.UTF-8 \
                            ansible-playbook \
                                -i "${ANSIBLE_INVENTORY}" \
                                "${ANSIBLE_PLAYBOOK}" \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts=${PATCH_SERVERS}" \
                                -e "EXCLUDE_PKGS="

                        fi

                        echo ""
                        echo "============================================"
                        echo "ANSIBLE PATCH COMPLETED"
                        echo "============================================"
                    '''
                }
            }
        }


        stage('Check Report') {

            steps {

                sh '''
                    set -eu

                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ ! -d "${REPORT_DIR}" ]; then
                        echo "ERROR: reports directory does not exist"
                        exit 1
                    fi

                    echo "Reports directory:"
                    ls -lah "${REPORT_DIR}"

                    echo ""
                    echo "HTML reports:"

                    find "${REPORT_DIR}" \
                        -type f \
                        -name '*.html' \
                        -print

                    REPORT_COUNT=$(find "${REPORT_DIR}" \
                        -type f \
                        -name '*.html' \
                        | wc -l)

                    echo ""
                    echo "HTML report count: ${REPORT_COUNT}"

                    if [ "${REPORT_COUNT}" -eq 0 ]; then
                        echo "ERROR: No HTML reports were generated."
                        exit 1
                    fi

                    echo ""
                    echo "Generated reports:"
                    find "${REPORT_DIR}" \
                        -type f \
                        -name '*.html' \
                        -exec ls -lh {} \\;

                    echo ""
                    echo "============================================"
                    echo "REPORT CHECK PASSED"
                    echo "============================================"
                '''
            }
        }


        stage('Archive Report') {

            steps {

                archiveArtifacts(
                    artifacts: 'reports/*.html',
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('Publish HTML Report') {

            steps {

                publishHTML(
                    target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports',
                        reportFiles: '*.html',
                        reportName: 'Linux OS Patch Report',
                        reportTitles: 'Linux OS Patch Report'
                    ]
                )
            }
        }
    }


    post {

        success {

            echo ''
            echo '============================================'
            echo '✅ PATCHING COMPLETED SUCCESSFULLY'
            echo '============================================'
            echo "Servers: ${params.PATCH_SERVERS}"
            echo 'HTML report archived and published.'
            echo '============================================'
        }


        failure {

            echo ''
            echo '============================================'
            echo '❌ PATCHING FAILED'
            echo '============================================'
            echo "Servers: ${params.PATCH_SERVERS}"
            echo 'Check the Ansible output above for details.'
            echo '============================================'
        }


        always {

            echo ''
            echo '============================================'
            echo 'CLEANING WORKSPACE'
            echo '============================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
