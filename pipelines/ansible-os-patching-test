pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            trim: true,
            description: 'Enter servers, semicolon separated. Example: lb1;lb2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            trim: true,
            description: 'Packages to exclude, semicolon separated. Example: kernel*;docker*'
        )
    }

    environment {
        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'

        ANSIBLE_FORCE_COLOR = 'false'
        ANSIBLE_NOCOLOR = 'false'

        ANSIBLE_HOST_KEY_CHECKING = 'false'

        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'

        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'

        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME cannot be empty')
                    }

                    echo '============================================'
                    echo 'PATCH REQUEST'
                    echo '============================================'
                    echo "Servers      : ${params.SERVER_NAME}"
                    echo "Exclude pkgs : ${params.EXCLUDE_PKGS?.trim() ?: 'NONE'}"
                    echo '============================================'
                }
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    export LANG=C.UTF-8
                    export LC_ALL=C.UTF-8

                    mkdir -p /tmp/ansible_tmp
                    mkdir -p /tmp/ansible_cp

                    mkdir -p reports

                    echo "Workspace:"
                    pwd

                    echo
                    echo "Checking Ansible files..."

                    test -f inventory/hosts
                    test -f ansible-roles/linux/os_update.yml

                    echo "OK: inventory/hosts"
                    echo "OK: ansible-roles/linux/os_update.yml"
                '''
            }
        }

        stage('Ansible Syntax Check') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        export LANG=C.UTF-8
                        export LC_ALL=C.UTF-8

                        echo "============================================"
                        echo "ANSIBLE SYNTAX CHECK"
                        echo "============================================"

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --syntax-check

                        echo "Syntax check: OK"
                    '''
                }
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        export LANG=C.UTF-8
                        export LC_ALL=C.UTF-8

                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION"
                        echo "============================================"
                        echo "Servers      : ${SERVER_NAME}"
                        echo "Exclude pkgs : ${EXCLUDE_PKGS:-NONE}"
                        echo "============================================"

                        mkdir -p reports

                        EXCLUDE_VALUE="${EXCLUDE_PKGS:-}"

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_VALUE}"

                        echo
                        echo "============================================"
                        echo "ANSIBLE PATCH EXECUTION COMPLETE"
                        echo "============================================"
                    '''
                }
            }
        }

        stage('Check Report') {
            steps {
                sh '''
                    set -eu

                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ -d reports ]; then
                        echo "Reports directory:"
                        ls -lah reports

                        echo
                        echo "HTML reports:"
                        find reports -type f -name '*.html' -print || true
                    else
                        echo "WARNING: reports directory does not exist"
                    fi

                    echo
                    echo "Searching workspace for HTML files:"
                    find . -type f -name '*.html' -print || true
                '''
            }
        }

        stage('Archive Report') {
            steps {
                script {
                    def reports = findFiles(
                        glob: 'reports/*.html'
                    )

                    if (reports.length == 0) {
                        echo 'WARNING: No HTML report was generated.'
                    } else {
                        echo "Found ${reports.length} HTML report(s)."

                        archiveArtifacts(
                            artifacts: 'reports/*.html',
                            fingerprint: true,
                            allowEmptyArchive: true
                        )
                    }
                }
            }
        }
    }

    post {

        success {
            echo '============================================'
            echo '✅ PATCHING COMPLETED SUCCESSFULLY'
            echo '============================================'
        }

        failure {
            echo '============================================'
            echo '❌ PATCHING FAILED'
            echo '============================================'
        }

        always {
            echo '============================================'
            echo 'CLEANING WORKSPACE'
            echo '============================================'

            cleanWs()
        }
    }
}
