pipeline {

    agent any

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: 'lb2',
            description: 'Target server(s), for example: lb2 or lb1,lb2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Packages to exclude, space separated. Leave empty for none.'
        )
    }

    environment {
        INVENTORY = 'inventory/hosts'
        PLAYBOOK  = 'ansible-roles/linux/os_update.yml'
        REPORT_DIR = 'reports'

        ANSIBLE_HOST_KEY_CHECKING = 'False'
        ANSIBLE_RETRY_FILES_ENABLED = 'False'
        ANSIBLE_DISPLAY_SKIPPED_HOSTS = 'False'
        ANSIBLE_NOCOLOR = 'False'

        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_SSH_PIPELINING = 'True'
    }

    options {
        timestamps()
        ansiColor('xterm')

        skipDefaultCheckout(false)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '20'
            )
        )
    }

    stages {

        /*
         * ============================================================
         * VALIDATE INPUT
         * ============================================================
         */
        stage('Validate Input') {
            steps {
                script {

                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME cannot be empty.')
                    }

                    echo '============================================'
                    echo 'PATCH MANAGEMENT'
                    echo '============================================'
                    echo "Servers      : ${params.SERVER_NAME}"
                    echo "Exclude pkgs : ${params.EXCLUDE_PKGS?.trim() ? params.EXCLUDE_PKGS : 'NONE'}"
                    echo '============================================'
                }
            }
        }


        /*
         * ============================================================
         * PREPARE
         * ============================================================
         */
        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    echo "Preparing Ansible environment..."

                    mkdir -p "$ANSIBLE_LOCAL_TEMP"
                    mkdir -p "$REPORT_DIR"
                    mkdir -p /tmp/ansible_cp

                    chmod 700 "$ANSIBLE_LOCAL_TEMP"
                    chmod 700 /tmp/ansible_cp

                    echo "Workspace : $(pwd)"
                    echo "Inventory : $INVENTORY"
                    echo "Playbook  : $PLAYBOOK"
                    echo "Reports   : $REPORT_DIR"

                    test -f "$INVENTORY"
                    test -f "$PLAYBOOK"

                    echo "Environment ready."
                '''
            }
        }


        /*
         * ============================================================
         * RUN ANSIBLE
         *
         * Important:
         * We capture Ansible output into a log instead of dumping every
         * task into the Jenkins console.
         * ============================================================
         */
        stage('Run Ansible Patching') {
            steps {

                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {

                    script {

                        /*
                         * Pass Jenkins parameters into environment variables.
                         *
                         * This avoids problems such as:
                         *
                         * SERVER_NAME: parameter not set
                         *
                         * and malformed shell expansions.
                         */
                        withEnv([
                            "PATCH_SERVER=${params.SERVER_NAME}",
                            "PATCH_EXCLUDE_PKGS=${params.EXCLUDE_PKGS ?: ''}"
                        ]) {

                            int ansibleResult = sh(
                                script: '''
                                    set -eu

                                    echo ""
                                    echo "============================================"
                                    echo "ANSIBLE PATCH EXECUTION"
                                    echo "============================================"
                                    echo "Servers      : $PATCH_SERVER"

                                    if [ -n "$PATCH_EXCLUDE_PKGS" ]; then
                                        echo "Exclude pkgs : $PATCH_EXCLUDE_PKGS"
                                    else
                                        echo "Exclude pkgs : NONE"
                                    fi

                                    echo "============================================"

                                    mkdir -p "$REPORT_DIR"
                                    mkdir -p "$ANSIBLE_LOCAL_TEMP"
                                    mkdir -p /tmp/ansible_cp

                                    chmod 700 "$ANSIBLE_LOCAL_TEMP"
                                    chmod 700 /tmp/ansible_cp

                                    EXCLUDE_ARGS=""

                                    if [ -n "$PATCH_EXCLUDE_PKGS" ]; then
                                        EXCLUDE_ARGS="-e EXCLUDE_PKGS=$PATCH_EXCLUDE_PKGS"
                                    fi

                                    echo "Starting Ansible..."
                                    echo ""

                                    set +e

                                    ansible-playbook \
                                        -i "$INVENTORY" \
                                        "$PLAYBOOK" \
                                        --private-key="$ANSIBLE_KEY_FILE" \
                                        -e "target_hosts=$PATCH_SERVER" \
                                        $EXCLUDE_ARGS \
                                        > ansible-output.log 2>&1

                                    ANSIBLE_RC=$?

                                    set -e

                                    echo ""
                                    echo "============================================"
                                    echo "ANSIBLE EXECUTION SUMMARY"
                                    echo "============================================"

                                    if [ "$ANSIBLE_RC" -eq 0 ]; then
                                        echo "Ansible status : SUCCESS"
                                    else
                                        echo "Ansible status : FAILED"
                                        echo "Exit code      : $ANSIBLE_RC"
                                    fi

                                    echo "============================================"

                                    echo ""
                                    echo "Last part of Ansible output:"
                                    echo "--------------------------------------------"

                                    tail -n 80 ansible-output.log || true

                                    echo "--------------------------------------------"

                                    exit "$ANSIBLE_RC"
                                ''',
                                returnStatus: true
                            )

                            /*
                             * Store result for later stages.
                             */
                            env.ANSIBLE_RESULT = ansibleResult.toString()

                            if (ansibleResult != 0) {
                                echo "Ansible returned exit code ${ansibleResult}."
                                echo "Continuing so that HTML reports can be archived/published."
                            } else {
                                echo "Ansible completed successfully."
                            }
                        }
                    }
                }
            }
        }


        /*
         * ============================================================
         * CHECK REPORT
         * ============================================================
         */
        stage('Check Report') {
            steps {

                sh '''
                    set -eu

                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ -d "$REPORT_DIR" ]; then

                        echo "Reports directory:"
                        ls -lah "$REPORT_DIR"

                        echo ""
                        echo "HTML reports:"
                        find "$REPORT_DIR" -type f -name '*.html' -print

                    else

                        echo "WARNING: Reports directory does not exist."

                    fi

                    echo ""
                    echo "Workspace HTML files:"
                    find . -type f -name '*.html' -print || true

                    echo "============================================"
                '''
            }
        }


        /*
         * ============================================================
         * ARCHIVE REPORT
         *
         * archiveArtifacts is built into Jenkins.
         * No findFiles plugin is required.
         * ============================================================
         */
        stage('Archive Report') {
            steps {

                archiveArtifacts(
                    artifacts: 'reports/*.html',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                archiveArtifacts(
                    artifacts: 'ansible-output.log',
                    allowEmptyArchive: true,
                    fingerprint: false
                )
            }
        }


        /*
         * ============================================================
         * PUBLISH HTML REPORT
         *
         * Requires Jenkins HTML Publisher plugin.
         * Your Jenkins appears to have publishHTML available.
         * ============================================================
         */
        stage('Publish HTML Report') {
            steps {

                script {

                    if (fileExists('reports')) {

                        publishHTML(
                            target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'reports',
                                reportFiles: '*.html',
                                reportName: 'Linux Patch Report',
                                reportTitles: 'Linux Patch Report'
                            ]
                        )

                    } else {

                        echo 'No reports directory found. Skipping HTML publication.'

                    }
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        always {

            echo '============================================'
            echo 'PATCHING JOB SUMMARY'
            echo '============================================'
            echo "Servers : ${params.SERVER_NAME}"

            script {

                if (env.ANSIBLE_RESULT) {
                    echo "Ansible exit code : ${env.ANSIBLE_RESULT}"
                } else {
                    echo 'Ansible exit code : NOT EXECUTED'
                }
            }

            echo '============================================'
        }


        success {

            echo '============================================'
            echo '✅ PATCHING COMPLETED SUCCESSFULLY'
            echo '============================================'
        }


        failure {

            echo '============================================'
            echo '❌ PATCHING FAILED'
            echo '============================================'
            echo "Servers: ${params.SERVER_NAME}"
            echo ''
            echo 'The Ansible execution failed.'
            echo 'The Ansible log and any generated HTML report were preserved.'
            echo '============================================'
        }


        cleanup {

            echo '============================================'
            echo 'CLEANING WORKSPACE'
            echo '============================================'
            cleanWs()
            echo 'Workspace cleaned.'
            echo '============================================'
        }
    }
}
