pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    parameters {

        string(
            name: 'SERVER_NAME',
            defaultValue: 'lb2',
            description: 'Ansible target host(s). Example: lb2 or lb1;lb2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Optional packages to exclude. Example: kernel*;openssl'
        )
    }

    environment {

        ANSIBLE_INVENTORY = 'inventory/hosts'
        ANSIBLE_PLAYBOOK = 'ansible-roles/linux/os_update.yml'

        REPORT_DIR = 'reports'

        ANSIBLE_LOCAL_TMP = '/tmp/ansible_cp'
        ANSIBLE_REMOTE_TMP = '/tmp/ansible_tmp'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {

                    echo '============================================'
                    echo 'PATCH MANAGEMENT'
                    echo '============================================'

                    echo "Servers      : ${params.SERVER_NAME}"

                    if (params.EXCLUDE_PKGS?.trim()) {
                        echo "Exclude pkgs : ${params.EXCLUDE_PKGS}"
                    } else {
                        echo 'Exclude pkgs : NONE'
                    }

                    echo '============================================'

                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME cannot be empty')
                    }
                }
            }
        }


        stage('Prepare') {
            steps {
                sh '''
                    set -eu

                    echo "Preparing Ansible environment..."

                    mkdir -p "${REPORT_DIR}"
                    mkdir -p "${ANSIBLE_LOCAL_TMP}"

                    chmod 700 "${ANSIBLE_LOCAL_TMP}"

                    echo "Workspace : $(pwd)"
                    echo "Inventory : ${ANSIBLE_INVENTORY}"
                    echo "Playbook  : ${ANSIBLE_PLAYBOOK}"
                    echo "Reports   : ${REPORT_DIR}"

                    test -f "${ANSIBLE_INVENTORY}"
                    test -f "${ANSIBLE_PLAYBOOK}"

                    echo "Environment ready."
                '''
            }
        }


        stage('Run Ansible Patching') {

            steps {

                /*
                 * Existing working Jenkins credential.
                 *
                 * This is a FILE credential containing
                 * the SSH private key.
                 */
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {

                    script {

                        sh '''
                            set -eu

                            echo ""
                            echo "============================================"
                            echo "ANSIBLE PATCH EXECUTION"
                            echo "============================================"
                            echo "Servers      : ${SERVER_NAME}"

                            if [ -n "${EXCLUDE_PKGS:-}" ]; then
                                echo "Exclude pkgs : ${EXCLUDE_PKGS}"
                            else
                                echo "Exclude pkgs : NONE"
                            fi

                            echo "============================================"

                            mkdir -p "${REPORT_DIR}"
                            mkdir -p "${ANSIBLE_LOCAL_TMP}"

                            chmod 700 "${ANSIBLE_LOCAL_TMP}"

                            echo ""
                            echo "Starting Ansible patch..."
                            echo ""

                            if [ -n "${EXCLUDE_PKGS:-}" ]; then

                                LANG=C.UTF-8 \
                                LC_ALL=C.UTF-8 \
                                ANSIBLE_LOCAL_TEMP="${ANSIBLE_LOCAL_TMP}" \
                                ansible-playbook \
                                    -i "${ANSIBLE_INVENTORY}" \
                                    "${ANSIBLE_PLAYBOOK}" \
                                    --private-key="${ANSIBLE_KEY_FILE}" \
                                    -e "target_hosts=${SERVER_NAME}" \
                                    -e "EXCLUDE_PKGS=${EXCLUDE_PKGS}"

                            else

                                LANG=C.UTF-8 \
                                LC_ALL=C.UTF-8 \
                                ANSIBLE_LOCAL_TEMP="${ANSIBLE_LOCAL_TMP}" \
                                ansible-playbook \
                                    -i "${ANSIBLE_INVENTORY}" \
                                    "${ANSIBLE_PLAYBOOK}" \
                                    --private-key="${ANSIBLE_KEY_FILE}" \
                                    -e "target_hosts=${SERVER_NAME}" \
                                    -e "EXCLUDE_PKGS="

                            fi

                            echo ""
                            echo "============================================"
                            echo "ANSIBLE PATCH COMPLETED"
                            echo "============================================"
                        '''
                    }
                }
            }
        }


        stage('Check Report') {

            steps {

                sh '''
                    set -eu

                    echo ""
                    echo "============================================"
                    echo "REPORT CHECK"
                    echo "============================================"

                    if [ ! -d "${REPORT_DIR}" ]; then
                        echo "ERROR: Reports directory does not exist."
                        exit 1
                    fi

                    echo ""
                    echo "Reports directory:"
                    ls -lah "${REPORT_DIR}"

                    echo ""
                    echo "HTML reports:"

                    find "${REPORT_DIR}" \
                        -type f \
                        -name '*.html' \
                        -print

                    REPORT_COUNT=$(
                        find "${REPORT_DIR}" \
                            -type f \
                            -name '*.html' \
                            | wc -l
                    )

                    echo ""
                    echo "HTML report count: ${REPORT_COUNT}"

                    if [ "${REPORT_COUNT}" -eq 0 ]; then
                        echo ""
                        echo "ERROR: No HTML reports were generated."
                        echo ""
                        echo "Searching entire workspace for HTML files:"
                        find . -type f -name '*.html' -print || true
                        exit 1
                    fi

                    echo ""
                    echo "Generated reports:"

                    find "${REPORT_DIR}" \
                        -type f \
                        -name '*.html' \
                        -exec ls -lh {} \\;

                    echo ""
                    echo "============================================"
                    echo "REPORT CHECK PASSED"
                    echo "============================================"
                '''
            }
        }


        stage('Archive Report') {

            steps {

                archiveArtifacts(
                    artifacts: 'reports/*.html',
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('Publish HTML Report') {

            steps {

                publishHTML(
                    target: [
                        reportDir: 'reports',
                        reportFiles: '*.html',
                        reportName: 'Linux OS Patch Report',
                        reportTitles: 'Linux OS Patch Report',
                        keepAll: true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: false
                    ]
                )
            }
        }
    }


    post {

        success {

            echo ""
            echo "============================================"
            echo "✅ PATCHING COMPLETED SUCCESSFULLY"
            echo "============================================"
            echo "Servers: ${params.SERVER_NAME}"
            echo "HTML report archived and published."
            echo "============================================"
        }


        failure {

            echo ""
            echo "============================================"
            echo "❌ PATCHING FAILED"
            echo "============================================"
            echo "Servers: ${params.SERVER_NAME}"
            echo "Check the Ansible output above for details."
            echo "============================================"
        }


        always {

            echo ""
            echo "============================================"
            echo "CLEANING WORKSPACE"
            echo "============================================"

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
