pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            description: 'Enter servers (semicolon separated): server1;server2'
        )

        string(
            name: 'EXCLUDE_PKGS',
            defaultValue: '',
            description: 'Packages to exclude (semicolon separated): kernel*;docker*'
        )
    }

    environment {
        /*
         * Locale
         */
        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'

        /*
         * Ansible
         *
         * FORCE_COLOR is required because Ansible may disable
         * colors when running inside Jenkins/non-interactive shell.
         *
         * Do NOT use "minimal" here.
         * This Ansible version supports yaml/json.
         */
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'

        /*
         * Temporary directories
         */
        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'

        /*
         * SSH
         */
        ANSIBLE_HOST_KEY_CHECKING = 'false'
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {

        /*
         * ============================================================
         * VALIDATE INPUT
         * ============================================================
         */
        stage('Validate Input') {
            steps {
                script {

                    if (!params.SERVER_NAME?.trim()) {
                        error('SERVER_NAME cannot be empty')
                    }

                    echo "Servers : ${params.SERVER_NAME}"
                    echo "Exclude : ${params.EXCLUDE_PKGS ?: 'none'}"
                }
            }
        }


        /*
         * ============================================================
         * PREPARE ANSIBLE
         * ============================================================
         */
        stage('Prepare Ansible') {
            steps {
                sh '''
                    set -eu
                    set +x

                    mkdir -p /tmp/ansible_tmp
                    mkdir -p /tmp/ansible_cp

                    chmod 700 /tmp/ansible_tmp
                    chmod 700 /tmp/ansible_cp
                '''
            }
        }


        /*
         * ============================================================
         * SYNTAX CHECK
         * ============================================================
         */
        stage('Syntax Check') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "Checking Ansible syntax..."

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_PKGS:-}" \
                            --syntax-check

                        echo "Syntax check: OK"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PATCH
         * ============================================================
         */
        stage('Patch') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key',
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo ""
                        echo "============================================"
                        echo "Starting patching: ${SERVER_NAME}"
                        echo "============================================"
                        echo ""

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/linux/os_update.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts=${SERVER_NAME}" \
                            -e "EXCLUDE_PKGS=${EXCLUDE_PKGS:-}"

                        echo ""
                        echo "Patching completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * CHECK REPORT
         * ============================================================
         */
        stage('Check Report') {
            steps {
                sh '''
                    set +x

                    if [ -d reports ]; then
                        find reports \
                            -type f \
                            -name '*.html' \
                            -print
                    else
                        echo "No reports directory found."
                    fi
                '''
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        success {
            echo "PATCH JOB SUCCESSFUL"
        }

        failure {
            echo "PATCH JOB FAILED"
        }

        always {
            sh '''
                set +x

                rm -rf /tmp/ansible_tmp/* 2>/dev/null || true
                rm -rf /tmp/ansible_cp/* 2>/dev/null || true
            '''
        }
    }
}
