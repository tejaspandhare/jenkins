pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Enter target server targets')
        string(name: 'EXCLUDE_PKGS', defaultValue: '', description: 'Exclusions list')
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true' 
        ANSIBLE_STDOUT_CALLBACK = 'yaml'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
        ANSIBLE_DEPRECATION_WARNINGS = 'false'
        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_HOST_KEY_CHECKING = 'false'
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {
        stage('Validate & Execute Patch') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) { error("SERVER_NAME cannot be empty.") }
                    
                    withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                        withEnv(["TARGET_SERVERS=${params.SERVER_NAME}", "EXCLUDED_PACKAGES=${params.EXCLUDE_PKGS}"]) {
                            sh '''#!/bin/bash
                                set -euo pipefail
                                mkdir -p /tmp/ansible_cp /tmp/ansible_tmp/run

                                ansible-playbook \
                                    -i inventory/hosts \
                                    ansible-roles/os_patching/patch2.yml \
                                  --private-key="${ANSIBLE_KEY_FILE}" \
                                    -e "target_hosts='${TARGET_SERVERS}'" \
                                    -e "EXCLUDE_PKGS='${EXCLUDED_PACKAGES:-}'" 2>&1 | grep -v "localhost" || true

                                # Safely pull the generated dashboard asset from the /tmp storage mount
                                if [ -f /tmp/patch_report.html ]; then
                                    cp /tmp/patch_report.html ./patch_report.html
                                fi
                            '''
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            archiveArtifacts artifacts: 'patch_report.html', allowEmptyArchive: true
        }
    }
}
