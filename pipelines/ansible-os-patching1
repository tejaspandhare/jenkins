pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Enter servers (semicolon separated): server1;server2')
        string(name: 'EXCLUDE_PKGS', defaultValue: '', description: 'Packages to exclude (semicolon separated): kernel*;docker*')
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true' 
        ANSIBLE_STDOUT_CALLBACK = 'yaml'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
        ANSIBLE_DEPRECATION_WARNINGS = 'false'
        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_HOST_KEY_CHECKING = 'false'
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {
        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error("SERVER_NAME parameter cannot be empty.")
                    }
                }
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    withEnv([
                        "TARGET_SERVERS=${params.SERVER_NAME}",
                        "EXCLUDED_PACKAGES=${params.EXCLUDE_PKGS}"
                    ]) {
                        sh '''#!/bin/bash
                            set -euo pipefail
                            
                            mkdir -p /tmp/ansible_cp /tmp/ansible_tmp/run

                            echo "========== RUNNING ENTERPRISE PATCHING ENGINE =========="
                            ansible-playbook \
                                -i inventory/hosts \
                                ansible-roles/os_patching/patch2.yml \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts='${TARGET_SERVERS}'" \
                                -e "EXCLUDE_PKGS='${EXCLUDED_PACKAGES:-}'"

                            echo ""
                            echo "========================================================"
                            echo "            ISOLATED TELEMETRY METRIC STREAM            "
                            echo "========================================================"
                            if [ -f /tmp/raw_patch_log.tmp ]; then
                                cp /tmp/raw_patch_log.tmp ./raw_patch_log.tmp || true
                                cat /tmp/raw_patch_log.tmp
                            else
                                echo "ERROR: Telemetry log file was not found in /tmp."
                                exit 1
                            fi
                            echo "========================================================"
                        '''
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "========== ARCHIVING AVAILABLE METRICS =========="
            archiveArtifacts artifacts: 'raw_patch_log.tmp', allowEmptyArchive: true
            // Bypassing workspace deletion to avoid crashing on the faulty I/O path mount
            // deleteDir()
        }
    }
}
