pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Enter servers (semicolon separated): server1;server2')
        string(name: 'EXCLUDE_PKGS', defaultValue: '', description: 'Packages to exclude (semicolon separated): kernel*;docker*')
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true' 
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_HOST_KEY_CHECKING = 'false'
        ANSIBLE_SSH_CONTROL_PATH_DIR = '/tmp/ansible_cp'
    }

    stages {
        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error("SERVER_NAME parameter cannot be empty.")
                    }
                }
            }
        }

        stage('Run Ansible Patching') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        
                        echo "========== PATCH EXECUTION =========="
                        echo "Running patching on: ${SERVER_NAME}"
                        echo "Excluding packages: ${EXCLUDE_PKGS:-none}"
                        
                        mkdir -p /tmp/ansible_cp /tmp/ansible_tmp/run

                        ansible-playbook \
                            -i inventory/hosts \
                            ansible-roles/os_patching/patch2.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "target_hosts='${SERVER_NAME}'" \
                            -e "EXCLUDE_PKGS='${EXCLUDE_PKGS:-}'" 2>&1 | tee raw_patch_log.tmp || true
                    '''
                }
            }
        }

        stage('Generate PDF Report') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    
                    echo "========== COMPILING PDF SYSTEM METRICS =========="
                    
                    python3 -c "import reportlab" 2>/dev/null || pip3 install --user reportlab --break-system-packages

                    cat << 'EOF' > generate_pdf.py
import os, re, time
from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

log_file = 'raw_patch_log.tmp'
pdf_file = 'ansible-roles/os_patching/reports/patch_report.pdf'

if not os.path.exists(log_file):
    print("Error: Missing execution data logs.")
    exit(1)

with open(log_file, 'r') as f:
    content = f.read()

match = re.search(r'REPORT_DATA_START(.*?)REPORT_DATA_END', content, re.DOTALL)
if not match:
    print("Warning: Log metadata stream block tokens missing from console output.")
    exit(0)

raw_data = match.group(1)

# Clean up ANSI color escaping blocks cleanly
ansi_regex = chr(27) + chr(91) + '[0-9;]*[a-zA-Z]'
raw_data = re.sub(ansi_regex, '', raw_data)
raw_data = raw_data.replace(r'\\\\n', chr(10)).replace(r'\\"', '"')

os.makedirs(os.path.dirname(pdf_file), exist_ok=True)
doc = SimpleDocTemplate(pdf_file, pagesize=letter, rightMargin=36, leftMargin=36, topMargin=40, bottomMargin=40)
story = []
styles = getSampleStyleSheet()

# Typography configuration profiles
title_style = ParagraphStyle('TitleStyle', parent=styles['Heading1'], fontSize=24, spaceAfter=6, textColor=colors.HexColor('#1A365D'))
meta_style = ParagraphStyle('MetaStyle', parent=styles['Normal'], fontSize=10, spaceAfter=15, textColor=colors.HexColor('#4A5568'))
section_style = ParagraphStyle('SectionStyle', parent=styles['Heading2'], fontSize=14, spaceBefore=12, spaceAfter=6, textColor=colors.HexColor('#2B6CB0'))
header_cell_style = ParagraphStyle('HeaderStyle', parent=styles['Normal'], fontSize=10, fontName='Helvetica-Bold', textColor=colors.white)
tbl_cell_style = ParagraphStyle('TblCellStyle', parent=styles['Normal'], fontSize=9, fontName='Helvetica')
code_cell_style = ParagraphStyle('CodeCellStyle', parent=styles['Normal'], fontSize=9, fontName='Courier')

story.append(Paragraph("ENTERPRISE LINUX PATCHING REPORT", title_style))
gen_time = time.strftime("%Y-%m-%d %H:%M:%S UTC")
story.append(Paragraph(f"Generated on: {gen_time}", meta_style))
story.append(Spacer(1, 10))

records = re.split(r'HOST_RECORD:', raw_data)
for record in records:
    if not record.strip():
        continue
    
    # Extract package section from data chunk safely
    pkg_match = re.search(r'PATCHED_PACKAGES_START(.*?)PATCHED_PACKAGES_END', record, re.DOTALL)
    pkg_lines = []
    if pkg_match:
        pkg_lines = [l.strip() for l in pkg_match.group(1).splitlines() if l.strip()]
        record_meta_part = record.split('PATCHED_PACKAGES_START')[0]
    else:
        record_meta_part = record

    lines = record_meta_part.splitlines()
    meta = {}
    for line in lines:
        clean_line = line.strip()
        if ':' in clean_line:
            k, v = clean_line.split(':', 1)
            meta[k.strip()] = v.strip()
            
    host_name = meta.get("HOST_RECORD", "Unknown Target")
    story.append(Paragraph(f"Host Execution Target: {host_name}", section_style))
    
    status_str = meta.get("STATUS", "SUCCESS")
    status_color = "#38A169" if status_str == "SUCCESS" else "#E53E3E"
    kernel_change = f"{meta.get('OLD_KERNEL', 'N/A')} -> {meta.get('NEW_KERNEL', 'N/A')}"
    
    # 1. Main Overview Summary Grid Table
    summary_content = [
        [Paragraph("Host Target", header_cell_style),
         Paragraph("Operating System", header_cell_style),
         Paragraph("Kernel Version Change", header_cell_style),
         Paragraph("Updated", header_cell_style),
         Paragraph("Reboot", header_cell_style),
         Paragraph("Status", header_cell_style)],
        [Paragraph(host_name, tbl_cell_style),
         Paragraph(meta.get("OS", "Unknown"), tbl_cell_style),
         Paragraph(kernel_change, tbl_cell_style),
         Paragraph(meta.get("UPDATED", "No"), tbl_cell_style),
         Paragraph(meta.get("REBOOT", "No"), tbl_cell_style),
         Paragraph(f"<font color='{status_color}'><b>{status_str}</b></font>", tbl_cell_style)]
    ]
    
    width_string = "90,110,140,60,60,80"
    calculated_widths = [int(w) for w in width_string.split(',')]
    
    summary_table = Table(summary_content, colWidths=calculated_widths)
    summary_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#2B6CB0')), 
        ('PADDING', (0,0), (-1,-1), 6),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#CBD5E0')),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE')
    ]))
    story.append(summary_table)
    story.append(Spacer(1, 10))
    
    # 2. Package Details Breakdown Table Grid with DPKG DNF State Normalization
    package_content = [[
        Paragraph("Package Name", header_cell_style),
        Paragraph("Last Version", header_cell_style),
        Paragraph("Updated Version", header_cell_style)
    ]]
    
    unique_packages = {}
    for p_line in pkg_lines:
        if "No packages updated." in p_line:
            break
            
        parts = p_line.split()
        if not parts:
            continue
            
        # Strip system operational prefixes (half-installed, installed, upgraded, etc.)
        if parts[0] in ['half-installed', 'installed', 'upgraded', 'unpacked', 'half-configured']:
            parts = parts[1:]
            
        if len(parts) >= 2:
            pkg_name = parts[0].split(':')[0] # Strip architecture tags (e.g. :amd64, :all)
            ver_val = parts[1]
            if ver_val == "<none>":
                ver_val = "N/A"
                
            if pkg_name not in unique_packages:
                unique_packages[pkg_name] = {'old': 'Unknown', 'new': ver_val}
            else:
                # If we parse multiple status lines, prioritize tracking chronological upgrade progressions
                if unique_packages[pkg_name]['old'] == 'Unknown' and unique_packages[pkg_name]['new'] != ver_val:
                    unique_packages[pkg_name]['old'] = unique_packages[pkg_name]['new']
                    unique_packages[pkg_name]['new'] = ver_val
                else:
                    unique_packages[pkg_name]['new'] = ver_val

    has_packages = False
    for name, vdata in sorted(unique_packages.items()):
        has_packages = True
        package_content.append([
            Paragraph(name, code_cell_style),
            Paragraph(vdata['old'], code_cell_style),
            Paragraph(vdata['new'], code_cell_style)
        ])
            
    if has_packages:
        story.append(Paragraph("<b>Patched Packages Details Breakdown:</b>", tbl_cell_style))
        story.append(Spacer(1, 4))
        
        pkg_width_str = "240,150,150"
        pkg_widths = [int(w) for w in pkg_width_str.split(',')]
        
        pkg_table = Table(package_content, colWidths=pkg_widths)
        pkg_table.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#4A5568')), 
            ('PADDING', (0,0), (-1,-1), 4),
            ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#E2E8F0')),
            ('ROWBACKGROUNDS', (0,1), (-1,-1), [colors.white, colors.HexColor('#F7FAFC')]),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE')
        ]))
        story.append(pkg_table)
    else:
        story.append(Paragraph("<i>No package modifications occurred during this run layout window.</i>", tbl_cell_style))
        
    story.append(Spacer(1, 15))

doc.build(story)
print("PDF compilation successful.")
EOF

