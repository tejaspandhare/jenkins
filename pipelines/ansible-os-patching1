pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: ansible-runner
    image: cytopia/ansible:latest
    command:
    - sh
    - -c
    # ✅ Fix: Install OpenSSH client and keep container alive
    - |
      if [ -f /usr/bin/apt-get ]; then
        apt-get update && apt-get install -y openssh-client
      elif [ -f /usr/bin/apk ]; then
        apk add --no-cache openssh-client
      fi
      cat
    tty: true
    volumeMounts:
    - mountPath: /tmp/ansible_tmp
      name: tmp-volume
  volumes:
  - name: tmp-volume
    emptyDir: {}
'''
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Enter servers (semicolon separated): server1;server2')
        string(name: 'EXCLUDE_PKGS', defaultValue: '', description: 'Packages to exclude (semicolon separated): kernel*;docker*')
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        ANSIBLE_CALLBACK_RESULT_FORMAT = 'yaml'
        ANSIBLE_LOCAL_TEMP = '/tmp/ansible_tmp'
        ANSIBLE_REMOTE_TEMP = '/tmp/ansible_tmp'
        # ✅ Recommended: Disable SSH Host Key Checking inside ephemeral runners
        ANSIBLE_HOST_KEY_CHECKING = 'false'
    }

    stages {
        stage('Validate Input') {
            steps {
                script {
                    if (!params.SERVER_NAME?.trim()) {
                        error("SERVER_NAME cannot be empty")
                    }
                }
            }
        }

        stage('Run Ansible Patching') {
            steps {
                container('ansible-runner') {
                    withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                        script {
                            sh """
                                mkdir -p /tmp/ansible_tmp/run
                                echo "========== PATCH EXECUTION =========="
                                echo "Running patching on: ${params.SERVER_NAME}"
                                echo "Excluding packages: ${params.EXCLUDE_PKGS}"

                                ansible-playbook \
                                    -i inventory/hosts \
                                    ansible-roles/os_patching/patch.yml \
                                    --private-key="$ANSIBLE_KEY_FILE" \
                                    -e "target_hosts=${params.SERVER_NAME}" \
                                    -e "EXCLUDE_PKGS=${params.EXCLUDE_PKGS}"
                            """
                        }
                    }
                }
            }
        }

        stage('Archive Report') {
            steps {
                container('ansible-runner') {
                    script {
                        echo "========== REPORT FILE =========="
                        sh 'ls -l ansible-roles/os_patching/reports || true'
                    }
                }
                archiveArtifacts artifacts: 'ansible-roles/os_patching/reports/*.html', fingerprint: true
            }
        }
    }

    post {
        success { echo "✅ Patching completed successfully" }
        failure { echo "❌ Patching failed" }
        always { cleanWs() }
    }
}
