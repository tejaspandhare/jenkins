pipeline {
    agent any
    options { timestamps(); ansiColor('xterm') }
    parameters {
        string(name: 'SERVER_NAME', defaultValue: '')
        string(name: 'EXCLUDE_PKGS', defaultValue: '')
    }
    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'yaml'
        ANSIBLE_DEPRECATION_WARNINGS = 'false'
    }
    stages {
        stage('Validate Input') {
            steps {
                script { if (!params.SERVER_NAME?.trim()) { error("Empty SERVER_NAME") } }
            }
        }
        stage('Run Ansible Patching') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    withEnv(["TARGET_SERVERS=${params.SERVER_NAME}", "EXCLUDED_PACKAGES=${params.EXCLUDE_PKGS}"]) {
                        sh '''#!/bin/bash
                            set -euo pipefail
                            mkdir -p /tmp/ansible_cp /tmp/ansible_tmp/run
                            ansible-playbook -i inventory/hosts ansible-roles/os_patching/patch2.yml \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts='${TARGET_SERVERS}'" \
                                -e "EXCLUDE_PKGS='${EXCLUDED_PACKAGES:-}'" 2>&1 | grep -v "localhost" || true
                            
                            if [ -f /tmp/raw_patch_log.tmp ]; then
                                cp /tmp/raw_patch_log.tmp ./raw_patch_log.tmp
                                cat ./raw_patch_log.tmp
                            else
                                echo "Telemetry missing"; exit 1
                            fi
                        '''
                    }
                }
            }
        }
        stage('Generate HTML Report') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    L="/tmp/raw_patch_log.tmp"
                    O="./patch_report.html"
                    [ ! -f "$L" ] && { echo "Log missing"; exit 0; }
                    TS=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
                    H=$(grep "HOST_RECORD:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    OS=$(grep "OS:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    OK=$(grep "OLD_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    NK=$(grep "NEW_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    UP=$(grep "UPDATED:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    RB=$(grep "REBOOT:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    ST=$(grep "STATUS:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    [ "$UP" = "Yes" ] && BU="success" || BU="neutral"
                    [ "$RB" = "Yes" ] && BR="warning" || BR="neutral"
                    [ "$ST" = "SUCCESS" ] && BS="success" || BS="danger"
                    [ "$OK" != "$NK" ] && KD="$OK &rarr; <small>$NK</small>" || KD="$OK"
                    PL=$(sed -n '/PATCHED_PACKAGES_START/,/PATCHED_PACKAGES_END/p' "$L" | grep -v "PATCHED_PACKAGES_" | xargs)
                    [ -z "$PL" ] && PB="<div>✨ System up to date.</div>" || PB="<pre>$PL</pre>"
                    cat <<EOF > "$O"
<!DOCTYPE html>
<html>
<head>
<title>Patching Report</title>
<style>
body{font-family:sans-serif;margin:40px;background:#f8fafc;color:#1e293b}
.box{background:#fff;padding:24px;border-radius:8px;border:1px solid #e2e8f0;margin-bottom:20px}
table{width:100%;border-collapse:collapse}
th,td{padding:12px;text-align:left;border-bottom:1px solid #e2e8f0}
th{background:#f8fafc;color:#64748b;font-size:11px;text-transform:uppercase}
.b{padding:4px 8px;border-radius:4px;font-size:12px;font-weight:600}
.success{background:#dcfce7;color:#15803d}
.warning{background:#fef3c7;color:#b45309}
.neutral{background:#f1f5f9;color:#475569}
.danger{background:#fee2e2;color:#b91c1c}
pre{background:#0f172a;color:#cbd5e1;padding:16px;border-radius:6px;overflow-x:auto}
</style>
</head>
<body>
<div class="box">
<h2>Enterprise Patching Dashboard</h2>
<small>Generated: ${TS}</small>
<table>
<thead><tr><th>Host</th><th>OS</th><th>Kernel</th><th>Patches</th><th>Reboot</th><th>Status</th></tr></thead>
<tbody><tr><td><b>${H}</b></td><td>${OS}</td><td>${KD}</td><td><span class="b ${BU}">${UP}</span></td><td><span class="b ${BR}">${RB}</span></td><td><span class="b ${BS}">${ST}</span></td></tr></tbody>
</table>
</div>
<div class="box">
<h3>${H} - Output</h3>
${PB}
</div>
</body>
</html>
EOF
                '''
            }
        }
    }
    post { always { archiveArtifacts artifacts: 'patch_report.html', allowEmptyArchive: true } }
}
