pipeline {
    agent any
    options { timestamps(); ansiColor('xterm') }
    parameters {
        string(name: 'SERVER_NAME', defaultValue: '')
        string(name: 'EXCLUDE_PKGS', defaultValue: '')
    }
    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'yaml'
        ANSIBLE_DEPRECATION_WARNINGS = 'false'
    }
    stages {
        stage('Patching') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    withEnv(["TSERVERS=${params.SERVER_NAME}", "EXPKGS=${params.EXCLUDE_PKGS}"]) {
                        sh '''#!/bin/bash
                            set -euo pipefail
                            mkdir -p /tmp/ansible_cp
                            ansible-playbook -i inventory/hosts ansible-roles/os_patching/patch2.yml \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts='${TSERVERS}'" \
                                -e "EXCLUDE_PKGS='${EXPKGS:-}'" 2>&1 | grep -v "localhost" || true
                        '''
                    }
                }
            }
        }
        stage('Report') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    L="/tmp/raw_patch_log.tmp"
                    O="./patch_report.html"
                    [ ! -f "$L" ] && { echo "Log missing"; exit 0; }
                    TIME=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
                    H=$(grep "HOST_RECORD:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "Unknown")
                    OS=$(grep "OS:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "Unknown")
                    OK=$(grep "OLD_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "N/A")
                    NK=$(grep "NEW_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "N/A")
                    UP=$(grep "UPDATED:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "No")
                    RB=$(grep "REBOOT:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "No")
                    ST=$(grep "STATUS:" "$L" | head -n 1 | cut -d':' -f2 | xargs || echo "SUCCESS")
                    [ "$OK" != "$NK" ] && KD="${OK} -> ${NK}" || KD="${OK}"

                    echo "<html><body style='font-family:sans-serif;padding:30px;background:#f8fafc;color:#1e293b'>" > "$O"
                    echo "<h2>Enterprise Patching Dashboard</h2><p>Run Time: ${TIME}</p>" >> "$O"
                    echo "<table border='1' cellpadding='10' style='border-collapse:collapse;width:100%;background:#fff;border-color:#e2e8f0'>" >> "$O"
                    echo "<tr style='background:#f8fafc;color:#64748b'><th>Host</th><th>OS</th><th>Kernel</th><th>Updates</th><th>Reboot</th><th>Status</th></tr>" >> "$O"
                    echo "<tr><td><b>${H}</b></td><td>${OS}</td><td>${KD}</td><td>${UP}</td><td>${RB}</td><td>${ST}</td></tr>" >> "$O"
                    echo "</table><h3>Detailed Package Changes Table</h3>" >> "$O"

                    PL=$(sed -n '/PATCHED_PACKAGES_START/,/PATCHED_PACKAGES_END/p' "$L" | grep -v "PATCHED_PACKAGES_")

                    if [ -z "${PL}" ]; then
                        echo "<div style='background:#f0fdf4;color:#166534;padding:15px;border-radius:6px'>✨ System is up to date. No updates applied.</div>" >> "$O"
                    else
                        echo "<table border='1' cellpadding='8' style='border-collapse:collapse;width:100%;background:#fff;border-color:#e2e8f0;font-size:13px'>" >> "$O"
                        echo "<tr style='background:#f8fafc;color:#475569'><th>Execution State</th><th>Package Name</th><th>Version Details</th></tr>" >> "$O"
                        
                        echo "${PL}" | while read -r line || [ -n "$line" ]; do
                            [ -z "$line" ] && continue
                            ACTION=$(echo "$line" | awk '{print $1}')
                            P_NAME=$(echo "$line" | awk '{print $2}')
                            P_VER=$(echo "$line" | awk '{print $3}')
                            echo "<tr><td><b style='color:#166534'>${ACTION}</b></td><td><b>${P_NAME}</b></td><td>${P_VER}</td></tr>" >> "$O"
                        done
                        echo "</table>" >> "$O"
                    fi
                    echo "</body></html>" >> "$O"
                '''
            }
        }
    }
    post { always { archiveArtifacts artifacts: 'patch_report.html', allowEmptyArchive: true } }
}
