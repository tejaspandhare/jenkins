pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
    }
    parameters {
        string(name: 'SERVER_NAME', defaultValue: '')
        string(name: 'EXCLUDE_PKGS', defaultValue: '')
    }
    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_STDOUT_CALLBACK = 'yaml'
        ANSIBLE_DEPRECATION_WARNINGS = 'false'
    }
    stages {
        stage('Patching') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'automation-key', 
                        variable: 'ANSIBLE_KEY_FILE'
                    )
                ]) {
                    withEnv([
                        "TSERVERS=${params.SERVER_NAME}",
                        "EXPKGS=${params.EXCLUDE_PKGS}"
                    ]) {
                        sh '''#!/bin/bash
                            set -euo pipefail
                            mkdir -p /tmp/ansible_cp
                            
                            ansible-playbook \
                                -i inventory/hosts \
                                ansible-roles/os_patching/patch2.yml \
                                --private-key="${ANSIBLE_KEY_FILE}" \
                                -e "target_hosts='${TSERVERS}'" \
                                -e "EXCLUDE_PKGS='${EXPKGS:-}'" \
                                2>&1 | grep -v "localhost" || true
                        '''
                    }
                }
            }
        }
        stage('Report') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    L="/tmp/raw_patch_log.tmp"
                    O="./patch_report.html"
                    
                    if [ ! -f "$L" ]; then
                        echo "Log missing"; exit 0
                    fi
                    
                    TIME=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
                    H=$(grep "HOST_RECORD:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    OS=$(grep "OS:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    OK=$(grep "OLD_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    NK=$(grep "NEW_KERNEL:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    UP=$(grep "UPDATED:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    RB=$(grep "REBOOT:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    ST=$(grep "STATUS:" "$L" | head -n 1 | cut -d':' -f2 | xargs)
                    
                    if [ "$UP" = "Yes" ]; then C_U="succ"; else C_U="neut"; fi
                    if [ "$RB" = "Yes" ]; then C_R="warn"; else C_R="neut"; fi
                    if [ "$ST" = "SUCCESS" ]; then C_S="succ"; else C_S="dang"; fi
                    
                    if [ "$OK" != "$NK" ]; then
                        KD="$OK &rarr; $NK"
                    else
                        KD="$OK"
                    fi
                    
                    PL=$(sed -n '/PATCHED_PACKAGES_START/,/PATCHED_PACKAGES_END/p' "$L" | grep -v "PATCHED_PACKAGES_" | xargs)
                    
                    if [ -z "$PL" ]; then
                        PB="<div class='info'>✨ System up to date.</div>"
                    else
                        PB="<pre class='list'>$PL</pre>"
                    fi
                    
                    cat <<EOF > "$O"
<!DOCTYPE html>
<html>
<head>
<title>Patch Report</title>
<style>
  body { font-family: sans-serif; background: #f8fafc; padding: 20px; }
  .box { background: #fff; padding: 20px; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 20px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 10px; border-bottom: 1px solid #e2e8f0; text-align: left; }
  .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
  .succ { background: #dcfce7; color: #15803d; }
  .warn { background: #fef3c7; color: #b45309; }
  .neut { background: #f1f5f9; color: #475569; }
  .dang { background: #fee2e2; color: #b91c1c; }
  .list { background: #0f172a; color: #cbd5e1; padding: 15px; border-radius: 6px; }
  .info { background: #f0fdf4; color: #166534; padding: 15px; border-radius: 6px; }
</style>
</head>
<body>
<div class="box">
  <h2>Patching Dashboard</h2>
  <p>Run Time: ${TIME}</p>
  <table>
    <tr><th>Host</th><th>OS</th><th>Kernel</th><th>Updates</th><th>Reboot</th><th>Status</th></tr>
    <tr><td><b>${H}</b></td><td>${OS}</td><td>${KD}</td><td><span class="badge ${C_U}">${UP}</span></td><td><span class="badge ${C_R}">${RB}</span></td><td><span class="badge ${C_S}">${ST}</span></td></tr>
  </table>
</div>
<div class="box">
  <h3>Package Output</h3>
  ${PB}
</div>
</body>
</html>
EOF
                    echo "HTML generated successfully."
                '''
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'patch_report.html', allowEmptyArchive: true
        }
    }
}
