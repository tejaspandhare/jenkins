pipeline {
    agent any

    environment {
        ANSIBLE_FORCE_COLOR = 'false'
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Target hosts separated by a semicolon (;)')
    }

    stages {
        stage('Audit OS Packages') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        if [ -z "${SERVER_NAME}" ]; then
                            echo "ERROR: SERVER_NAME parameter cannot be empty."
                            exit 1
                        fi

                        # Run playbook to collect console data outputs
                        ansible-playbook \
                            -i inventory/hosts \
                            playbooks/pkg_update_list.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "hosts_param='${SERVER_NAME}'" > raw_ansible_log.tmp 2>&1 || true

                        # Use an inline python parsing script to safely format the log data without sed errors
                        python3 -c "
import os, re, time

log_file = 'raw_ansible_log.tmp'
out_file = 'playbooks/os_update_report.txt'

if not os.path.exists(log_file):
    print('Error: Ansible log not found.')
    exit(1)

with open(log_file, 'r') as f:
    content = f.read()

# Locate data block between markers
match = re.search(r'REPORT_JSON_DATA_START(.*?)REPORT_JSON_DATA_END', content, re.DOTALL)
if not match:
    print('Error: Data markers missing from output.')
    exit(0)

data_block = match.group(1)

with open(out_file, 'w') as out:
    out.write('GLOBAL OS UPDATE REPORT\\n')
    out.write(f'Generated on: {time.strftime(\"%a %b %d %H:%M:%S %Z %Y\")}\\n')
    out.write('============================================================\\n\\n')
    
    # Process individual hosts blocks
    records = re.findall(r'SERVER_RECORD:(.*?)(?=SERVER_RECORD:|$)', data_block, re.DOTALL)
    for record in records:
        lines = record.strip().split('\\n')
        host_meta = {}
        details = []
        in_details = False
        
        for line in lines:
            line_str = line.strip().replace('\\\\\"', '\"')
            if 'DETAILS_START' in line_str:
                in_details = True
                continue
            if 'DETAILS_END' in line_str:
                in_details = False
                continue
            if in_details:
                # Clean up nested newline strings from debug serialization
                details.append(line_str.replace('\\\\n', '\\n'))
            else:
                if ':' in line_str:
                    k, v = line_str.split(':', 1)
                    host_meta[k.strip()] = v.strip()

        # Generate structured clean text block
        server_name = host_meta.get('SERVER_RECORD', 'Unknown')
        out.write(f'Server name: {server_name}\\n')
        out.write('============================================================\\n')
        out.write(f'Server hostname: {host_meta.get(\"HOSTNAME\", \"Unknown\")}\\n')
        out.write(f'Server OS: {host_meta.get(\"OS\", \"Unknown\")}\\n')
        out.write(f'Number of updates available: {host_meta.get(\"COUNT\", \"0\")}\\n\\n')
        
        if details:
            out.write('\\n'.join(details) + '\\n')
            
        out.write(f'\\nStatus: {host_meta.get(\"STATUS\", \"FAILED\")}\\n')
        out.write('============================================================\\n\\n')
"

                        # Clean up intermediate workspace artifacts
                        rm -f raw_ansible_log.tmp
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'ls -lah playbooks/'
            archiveArtifacts artifacts: 'playbooks/os_update_report.txt', allowEmptyArchive: true
        }
    }
}
