pipeline {
    agent any

    environment {
        ANSIBLE_FORCE_COLOR = 'false' // Disables ANSI color injection inside logs
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: 'localhost', description: 'Target hosts separated by a semicolon (;)')
    }

    stages {
        stage('Audit OS Packages') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    sh '''
                        # Run playbook cleanly to let it generate the static report file natively
                        ansible-playbook \
                            -i inventory/hosts \
                            playbooks/pkg_update_list.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "hosts='${SERVER_NAME}'"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                // Safely migrate the cleanly built text file to your playbooks archive directory
                sh 'if [ -f os_update_report.txt ]; then mv os_update_report.txt playbooks/os_update_report.txt; fi'
                sh 'ls -lah playbooks/'
            }
            archiveArtifacts artifacts: 'playbooks/os_update_report.txt', allowEmptyArchive: true
        }
    }
}
