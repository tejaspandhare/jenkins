pipeline {
    agent any

    environment {
        ANSIBLE_FORCE_COLOR = 'false'
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: '', description: 'Target hosts separated by a semicolon (;)')
    }

    stages {
        stage('Audit OS Packages') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        if [ -z "${SERVER_NAME}" ]; then
                            echo "ERROR: SERVER_NAME parameter cannot be empty."
                            exit 1
                        fi

                        # 1. Run the playbook to gather structural data logs
                        ansible-playbook \
                            -i inventory/hosts \
                            playbooks/pkg_update_list.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "hosts_param='${SERVER_NAME}'" > raw_ansible_log.tmp 2>&1 || true

                        # 2. Safely bypass PEP 668 to guarantee reportlab is available
                        python3 -c "import reportlab" 2>/dev/null || pip3 install --user reportlab --break-system-packages

                        # 3. Create an enhanced Python parser to build a beautifully formatted PDF table
                        cat << 'EOF' > parse_to_pdf.py
import os, re, time
from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

log_file = 'raw_ansible_log.tmp'
pdf_file = 'playbooks/os_update_report.pdf'

if not os.path.exists(log_file):
    print("Error: Missing raw data log.")
    exit(1)

with open(log_file, 'r') as f:
    content = f.read()

match = re.search(r'REPORT_JSON_DATA_START(.*?)REPORT_JSON_DATA_END', content, re.DOTALL)
if not match:
    print("Warning: Missing layout data tags inside log stream.")
    exit(0)

raw_data = match.group(1).replace(r'\\n', chr(10)).replace(r'\\"', '"')

# Initialize PDF properties
os.makedirs(os.path.dirname(pdf_file), exist_ok=True)
doc = SimpleDocTemplate(pdf_file, pagesize=letter, rightMargin=36, leftMargin=36, topMargin=40, bottomMargin=40)
story = []
styles = getSampleStyleSheet()

# Custom color palette and text formatting definitions
title_style = ParagraphStyle('TitleStyle', parent=styles['Heading1'], fontSize=24, spaceAfter=6, textColor=colors.HexColor('#1A365D'))
meta_style = ParagraphStyle('MetaStyle', parent=styles['Normal'], fontSize=10, spaceAfter=15, textColor=colors.HexColor('#4A5568'))
section_style = ParagraphStyle('SectionStyle', parent=styles['Heading2'], fontSize=14, spaceBefore=10, spaceAfter=8, textColor=colors.HexColor('#2B6CB0'))
body_style = ParagraphStyle('BodyStyle', parent=styles['Normal'], fontSize=10, leading=14)
header_cell_style = ParagraphStyle('HeaderStyle', parent=styles['Normal'], fontSize=10, fontName='Helvetica-Bold', textColor=colors.white)
tbl_cell_style = ParagraphStyle('TblCellStyle', parent=styles['Normal'], fontSize=9, fontName='Courier')

story.append(Paragraph("GLOBAL OS UPDATE REPORT", title_style))
gen_time = time.strftime("%Y-%m-%d %H:%M:%S UTC")
story.append(Paragraph(f"Generated on: {gen_time}", meta_style))
story.append(Spacer(1, 5))

records = re.split(r'SERVER_RECORD:', raw_data)

for record in records:
    if not record.strip():
        continue
        
    lines = record.splitlines()
    host_meta = {}
    package_rows = []
    in_details = False
    
    host_meta['SERVER_RECORD'] = lines[0].strip()
    
    for line in lines[1:]:
        clean_line = line.strip()
        if not clean_line or '----------------------------------------' in clean_line:
            continue
            
        if 'DETAILS_START' in clean_line:
            in_details = True
            continue
        if 'DETAILS_END' in clean_line:
            in_details = False
            continue
            
        if in_details:
            # Parse package column fields by splitting whitespace sequences
            parts = clean_line.split()
            if len(parts) >= 3:
                package_rows.append([parts[0], parts[1], parts[2]])
            elif len(parts) == 2:
                package_rows.append([parts[0], "Unknown", parts[1]])
            elif "System is up to date." in clean_line:
                package_rows.append(["System is up to date.", "", ""])
        else:
            if ':' in clean_line:
                k, v = clean_line.split(':', 1)
                host_meta[k.strip()] = v.strip()

    srv = host_meta.get('SERVER_RECORD', 'Unknown Node')
    story.append(Paragraph(f"Server Instance Summary: {srv}", section_style))
    
    # Render main host properties container grid
    status_str = host_meta.get("STATUS", "SUCCESS")
    status_color = "#38A169" if status_str == "SUCCESS" else "#E53E3E"
    
    meta_data = [
        [Paragraph("<b>Hostname:</b>", body_style), Paragraph(host_meta.get("HOSTNAME", "Unknown"), body_style)],
        [Paragraph("<b>Operating System:</b>", body_style), Paragraph(host_meta.get("OS", "Unknown"), body_style)],
        [Paragraph("<b>Updates Available:</b>", body_style), Paragraph(host_meta.get("COUNT", "0"), body_style)],
        [Paragraph("<b>Execution Status:</b>", body_style), Paragraph(f"<font color='{status_color}'><b>{status_str}</b></font>", body_style)]
    ]
    meta_table = Table(meta_data, colWidths=[140, 400])
    meta_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), colors.HexColor('#F7FAFC')),
        ('PADDING', (0,0), (-1,-1), 5),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#CBD5E0')),
    ]))
    story.append(meta_table)
    story.append(Spacer(1, 10))
    
    # Build package list in a clean table grid with matching header fields
    if package_rows:
        story.append(Paragraph("<b>Available Package Update Matrix:</b>", body_style))
        story.append(Spacer(1, 4))
        
        # Build headers row block
        table_content = [[
            Paragraph("Package Name", header_cell_style), 
            Paragraph("Current Version", header_cell_style), 
            Paragraph("Target Version", header_cell_style)
        ]]
        
        for row in package_rows:
            table_content.append([
                Paragraph(row[0], tbl_cell_style),
                Paragraph(row[1], tbl_cell_style),
                Paragraph(row[2], tbl_cell_style)
            ])
            
        pkg_table = Table(table_content, colWidths=[240, 150, 150])
        pkg_table.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#2B6CB0')), # Indigo header fill
            ('PADDING', (0,0), (-1,-1), 4),
            ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor('#E2E8F0')),
            ('ROWBACKGROUNDS', (0,1), (-1,-1), [colors.white, colors.HexColor('#F7FAFC')]), # Zebra striping
        ]))
        story.append(pkg_table)
        
    story.append(Spacer(1, 20))

doc.build(story)
print("PDF compilation successful.")
EOF

                        # 4. Execute the Python tool layer
                        python3 parse_to_pdf.py

                        # 5. Clean up temporary workspace artifacts
                        rm -f raw_ansible_log.tmp parse_to_pdf.py
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'ls -lah playbooks/'
            archiveArtifacts artifacts: 'playbooks/os_update_report.pdf', allowEmptyArchive: true
        }
    }
}
