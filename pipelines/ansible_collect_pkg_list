pipeline {
    agent any

    environment {
        ANSIBLE_FORCE_COLOR = 'true'
    }

    parameters {
        string(name: 'SERVER_NAME', defaultValue: 'localhost', description: 'Target hosts separated by a semicolon (;)')
    }

    stages {
        stage('Audit OS Packages') {
            steps {
                withCredentials([file(credentialsId: 'automation-key', variable: 'ANSIBLE_KEY_FILE')]) {
                    sh '''
                        ansible-playbook \
                            -i inventory/hosts \
                            playbooks/pkg_update_list.yml \
                            --private-key="$ANSIBLE_KEY_FILE" \
                            -e "hosts='${SERVER_NAME}'"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'ls -lah playbooks/'
            archiveArtifacts artifacts: 'playbooks/os_update_report.txt', allowEmptyArchive: true
        }
    }
}
